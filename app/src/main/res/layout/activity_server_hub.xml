<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Top Minimal Header Bar -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:background="#000000">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/view_status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#00E676"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Hub"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:background="#111111"
            android:paddingHorizontal="14dp"
            android:text="ONLINE"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:contentDescription="Server status: Online" />
    </LinearLayout>

    <View
        android:id="@+id/divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/layout_top_bar"
        android:background="#161616" />

    <!-- Bottom Navigation Bar -->
    <View
        android:id="@+id/divider_bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/bottom_navigation"
        android:background="#161616" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        app:elevation="0dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:itemRippleColor="#1A00E676"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_server_hub_bottom_nav" />

    <!-- Main Content Container with Tabs -->
    <ViewFlipper
        android:id="@+id/view_flipper_tabs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/divider_top"
        android:layout_above="@id/divider_bottom">

        <!-- ================= PAGE 0: OVERVIEW ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_tab_overview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Hero IP & Tunnel Toggle Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_hero_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Public IPv6 Tunnel"
                                android:textColor="#888888"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_public_ipv6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:text="2a11:6c7:f07:71a::2"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_master_tunnel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:checked="false"
                            android:contentDescription="Toggle WireGuard Tunnel"
                            app:useMaterialThemeColors="false"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SSH Quick-Connect Card (Single-tap copy) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ssh_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="Copy SSH connection command. Double tap to copy to clipboard."
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SSH Connect Command"
                                android:textColor="#888888"
                                android:textSize="13sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_copy"
                                    android:layout_marginEnd="5dp"
                                    app:tint="#00E676" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tap to Copy"
                                    android:textColor="#00E676"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_ssh_connect_cmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="ssh u0_a398@2a11:6c7:f07:71a::2 -p 2222"
                            android:textColor="#80D8FF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Double-tap card to copy SSH terminal command"
                            android:textColor="#555555"
                            android:textSize="12sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Outlined Restart SSH Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_restart_sshd"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Restart SSH Daemon (Port 8022)"
                    android:textAllCaps="false"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#222222" />

                <!-- Environment & Status (Clean List Style) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENVIRONMENT STATUS"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Item 1: Linux User -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sandbox User"
                                android:textColor="#CCCCCC"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_local_user"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="u0_a398"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#141414" />

                        <!-- Item 2: SSH Daemon -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Internal SSH Server"
                                android:textColor="#CCCCCC"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_ssh_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="Port 8022 (Active)"
                                android:textColor="#00E676"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#141414" />

                        <!-- Item 3: Active Ports -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Forwarded Ports"
                                android:textColor="#CCCCCC"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_active_ports_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="2 Active Rules"
                                android:textColor="#BB86FC"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#141414" />

                        <!-- Item 4: Firewall Status -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="18dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Firewall Filter"
                                android:textColor="#CCCCCC"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_overview_firewall_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active (Protected)"
                                android:textColor="#00E676"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================= PAGE 1: PORT RULES ================= -->
        <LinearLayout
            android:id="@+id/layout_tab_ports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Port Forwarding"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:text="Route incoming tunnel traffic to your sandbox games and services"
                android:textColor="#888888"
                android:textSize="13sp" />

            <!-- Top Firewall Protection Toggle Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_firewall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#0D0D0D"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#1A1A1A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_shield"
                            android:layout_marginEnd="10dp"
                            app:tint="#00E676" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Port Forwarding Firewall"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_firewall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:checked="true"
                            android:contentDescription="Toggle port forwarding firewall"
                            app:useMaterialThemeColors="false"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:trackTint="@color/switch_track_selector" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_firewall_status_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="● Firewall Active: Only allowed rules below forward traffic to your sandbox."
                        android:textColor="#00E676"
                        android:textSize="13sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Prominent Add Port Rule Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_port"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:text="+ Add Port Rule"
                android:textAllCaps="false"
                android:textColor="@android:color/black"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Add new port forwarding rule"
                app:backgroundTint="#00E676"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/tv_empty_ports"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:gravity="center"
                android:text="No custom port rules added.\nTap '+ Add Port Rule' to route gaming or web traffic."
                android:textColor="#666666"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_port_rules"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

        </LinearLayout>

        <!-- ================= PAGE 2: SETTINGS & TOOLS ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_tab_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings &amp; Tools"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="20dp"
                    android:text="Configuration, security, and background keep-alive"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <!-- Group 1: WireGuard Connection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIREGUARD CONFIGURATION"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tv_settings_conf_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Tunnel IP: 2a11:6c7:f07:71a::2/64"
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_import_conf"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Import New .conf File"
                            android:textAllCaps="false"
                            android:textColor="#BB86FC"
                            android:contentDescription="Import new WireGuard configuration file"
                            app:cornerRadius="12dp"
                            app:strokeColor="#BB86FC" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group 2: Security & Authentication -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTHENTICATION &amp; ACCESS"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Update your Linux user password for remote SSH connections."
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_change_password"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Change SSH Password"
                            android:textAllCaps="false"
                            android:textColor="#00E676"
                            android:contentDescription="Change SSH user login password"
                            app:cornerRadius="12dp"
                            app:strokeColor="#00E676" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group 3: System & Optimization -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM &amp; BACKGROUND EXECUTION"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="To ensure games and SSH remain 100% online with the screen turned off, set battery usage to Unrestricted."
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_battery_settings"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Configure Battery Settings"
                            android:textAllCaps="false"
                            android:textColor="#64B5F6"
                            android:contentDescription="Open Android battery optimization settings"
                            app:cornerRadius="12dp"
                            app:strokeColor="#64B5F6" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group 4: Sandbox Backup & Restore -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SANDBOX BACKUP &amp; RESTORE"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Create a compressed .tar.gz archive of your entire Linux sandbox, installed packages, files, and WireGuard keys to save or send anywhere."
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_export_backup"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Export Sandbox Backup (.tar.gz)"
                            android:textAllCaps="false"
                            android:textColor="#00E676"
                            android:contentDescription="Export entire Linux sandbox to compressed backup file"
                            app:cornerRadius="12dp"
                            app:strokeColor="#00E676"
                            android:layout_marginBottom="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_restore_backup"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Restore from Backup File"
                            android:textAllCaps="false"
                            android:textColor="#80D8FF"
                            android:contentDescription="Restore sandbox and configs from backup archive"
                            app:cornerRadius="12dp"
                            app:strokeColor="#80D8FF" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group 5: Updates -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPLICATION UPDATES"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/tv_settings_current_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Server Hub v1.0.0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Check GitHub releases for new features, stability improvements, and updates."
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_check_updates"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Check for Updates"
                            android:textAllCaps="false"
                            android:textColor="#00E676"
                            android:contentDescription="Check GitHub for newer Server Hub releases"
                            app:cornerRadius="12dp"
                            app:strokeColor="#00E676" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Group 6: Maintenance & Factory Reset -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAINTENANCE &amp; RESET"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    app:cardBackgroundColor="#0D0D0D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#1A1A1A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Re-run the initial environment setup, packages, and WireGuard import wizard."
                            android:textColor="#CCCCCC"
                            android:textSize="13sp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_open_setup"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Relaunch Setup Wizard"
                            android:textAllCaps="false"
                            android:textColor="#888888"
                            android:contentDescription="Relaunch initial setup wizard"
                            app:cornerRadius="12dp"
                            app:strokeColor="#333333"
                            android:layout_marginBottom="18dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#1A1A1A"
                            android:layout_marginBottom="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Permanently wipe all packages, user files, WireGuard configurations, and reset to clean state."
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:layout_marginBottom="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_erase_all_data"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Erase All Data (Factory Reset)"
                            android:textAllCaps="false"
                            android:textColor="#FF5252"
                            android:contentDescription="Permanently erase all sandbox data and reset to initial state"
                            app:cornerRadius="12dp"
                            app:strokeColor="#FF5252" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </ViewFlipper>

</RelativeLayout>
