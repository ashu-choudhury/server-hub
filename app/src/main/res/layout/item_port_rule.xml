<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#0D0D0D"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#1A1A1A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_port_protocol_badge"
            android:layout_width="46dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="#161B22"
            android:text="TCP"
            android:textColor="#80D8FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="yes" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_port_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSH Access (Port 2222)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_port_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="monospace"
                android:text="Port 2222 → 127.0.0.1:8022"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_port_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Toggle port rule"
            app:useMaterialThemeColors="false"
            app:thumbTint="#00E676"
            app:trackTint="#3300E676" />

        <ImageButton
            android:id="@+id/btn_delete_port"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:contentDescription="Delete port rule"
            app:tint="#888888" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
