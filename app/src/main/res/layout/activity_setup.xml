<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Title & Subtitle Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Setup Wizard"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Initialize your isolated sandbox, configure SSH credentials, and link your public IPv6 WireGuard tunnel."
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Step 1: Environment & Package Setup Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 1: Environment &amp; Packages"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step1_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#333333"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="PENDING"
                        android:textColor="#FFB74D"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Extracts the sandbox base system and installs OpenSSH server and networking tools."
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <ProgressBar
                    android:id="@+id/progress_step1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step1_install"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Initialize Environment &amp; Install OpenSSH"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#6200EE" />

                <!-- Collapsible Step 1 Log View -->
                <ScrollView
                    android:id="@+id/scroll_step1_logs"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="#0A0A0A"
                    android:layout_marginTop="10dp"
                    android:padding="6dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_step1_logs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text=""
                        android:textColor="#81C784"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 2: SSH Credentials Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_step2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 2: SSH Credentials"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step2_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#333333"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="LOCKED"
                        android:textColor="#777777"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configure a login password for your SSH client. You will use this password to connect to your phone terminal."
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp" />

                <!-- Detected user info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#161616"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_step2_user_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="SSH User: u0_a... | Internal Port: 8022"
                        android:textColor="#4DD0E1"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:hintTextColor="#BB86FC"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#BB86FC">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_ssh_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter SSH Password"
                        android:inputType="textPassword"
                        android:textColor="@android:color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintTextColor="#BB86FC"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#BB86FC">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_ssh_password_confirm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Confirm SSH Password"
                        android:inputType="textPassword"
                        android:textColor="@android:color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step2_set_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set Password &amp; Start SSH Server"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#03DAC5" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 3: WireGuard Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_step3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Step 3: WireGuard Tunnel"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_step3_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#333333"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="LOCKED"
                        android:textColor="#777777"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import your WireGuard .conf file (e.g. from Route48) to give your phone a static public IPv6 address."
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step3_import_conf"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select WireGuard .conf File"
                    android:textColor="#BB86FC"
                    app:strokeColor="#BB86FC"
                    android:layout_marginBottom="10dp" />

                <!-- Config details box -->
                <LinearLayout
                    android:id="@+id/layout_step3_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#161616"
                    android:padding="8dp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tv_step3_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="IPv6: - "
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tv_step3_endpoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Endpoint: - "
                        android:textColor="#888888"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_step3_test_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test &amp; Connect WireGuard"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#00C853"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Step 4: Completion Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_step4_complete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1A2E1A"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="#00E676"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ Setup Completed Successfully!"
                    android:textColor="#00E676"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your sandbox environment, OpenSSH server, and userspace WireGuard tunnel are ready."
                    android:textColor="#DDDDDD"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#122012"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_summary_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Username: -"
                        android:textColor="#E0E0E0"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_summary_ipv6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="Tunnel IPv6: -"
                        android:textColor="#80D8FF"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_summary_ssh_command"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="SSH Connect: ssh ..."
                        android:textColor="#B9F6CA"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_go_to_hub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Go to Server Hub"
                    android:textColor="@android:color/black"
                    app:backgroundTint="#00E676" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
