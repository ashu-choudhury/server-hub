<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Persistent Progress Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_step_indicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Step 1 of 4: Environment"
                android:textColor="#BB86FC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_overall_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25%"
                android:textColor="#888888"
                android:textSize="13sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_overall"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="25"
            android:progressTint="#BB86FC" />
    </LinearLayout>

    <!-- Paged ViewFlipper -->
    <ViewFlipper
        android:id="@+id/view_flipper_setup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= PAGE 0: Environment Setup ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#0A0A0A"
                app:strokeColor="#1E1E1E"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Initialize Sandbox"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Extracts the isolated headless Linux environment and installs the OpenSSH server and required networking tools."
                        android:textColor="#AAAAAA"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginBottom="28dp" />

                    <!-- Circular Percentage Indicator -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:id="@+id/tv_step1_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#BB86FC"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ProgressBar
                            android:id="@+id/progress_step1_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="220dp"
                            android:layout_height="10dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#03DAC5"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_step1_status_msg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready to install"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginBottom="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_step1_start"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Start Installation"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        app:backgroundTint="#6200EE"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_page0_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next  →"
                    android:textColor="@android:color/black"
                    android:enabled="false"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= PAGE 1: SSH Credentials Setup ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#0A0A0A"
                app:strokeColor="#1E1E1E"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configure SSH Access"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Set a login password for your SSH client. You will use this password to connect to your phone terminal."
                        android:textColor="#AAAAAA"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <!-- User info box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#161616"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tv_page1_user_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="SSH User: u0_a... | Port: 8022"
                            android:textColor="#4DD0E1"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Enter SSH Password"
                        app:boxStrokeColor="#BB86FC"
                        app:hintTextColor="#BB86FC"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#BB86FC">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_page1_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@android:color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Confirm SSH Password"
                        app:boxStrokeColor="#BB86FC"
                        app:hintTextColor="#BB86FC"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#BB86FC">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_page1_confirm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@android:color/white" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_page1_apply"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Save Password &amp; Start SSH"
                        android:textColor="@android:color/black"
                        android:textSize="15sp"
                        app:backgroundTint="#03DAC5"
                        app:cornerRadius="10dp" />

                    <TextView
                        android:id="@+id/tv_page1_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"
                        android:gravity="center" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_page1_back"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Back"
                    android:textColor="#BB86FC"
                    app:strokeColor="#BB86FC"
                    app:cornerRadius="8dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_page1_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next  →"
                    android:textColor="@android:color/black"
                    android:enabled="false"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= PAGE 2: WireGuard Tunnel ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#0A0A0A"
                app:strokeColor="#1E1E1E"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WireGuard Tunnel"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select your WireGuard configuration file (.conf) to assign a static public IPv6 address to your phone."
                        android:textColor="#AAAAAA"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_page2_select_conf"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Select WireGuard .conf File"
                        android:textColor="#BB86FC"
                        app:strokeColor="#BB86FC"
                        app:cornerRadius="10dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Config details box -->
                    <LinearLayout
                        android:id="@+id/layout_page2_conf_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#161616"
                        android:padding="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tv_page2_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Public IPv6: - "
                            android:textColor="#80D8FF"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_page2_endpoint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Endpoint: - "
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_page2_connect"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Connect &amp; Test Tunnel"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:backgroundTint="#00C853"
                        app:cornerRadius="10dp" />

                    <TextView
                        android:id="@+id/tv_page2_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#00E676"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"
                        android:gravity="center" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_page2_back"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Back"
                    android:textColor="#BB86FC"
                    app:strokeColor="#BB86FC"
                    app:cornerRadius="8dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_page2_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next  →"
                    android:textColor="@android:color/black"
                    android:enabled="false"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= PAGE 3: Summary / All Set ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#0A0A0A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#00E676"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Setup Completed!"
                        android:textColor="#00E676"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your headless server environment, OpenSSH service, and userspace WireGuard tunnel are ready."
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginBottom="24dp" />

                    <!-- Summary Info Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#121212"
                        android:padding="16dp"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:id="@+id/tv_page3_user"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Username: u0_a..."
                            android:textColor="#E0E0E0"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tv_page3_ipv6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="Tunnel IPv6: -"
                            android:textColor="#80D8FF"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/tv_page3_ssh_cmd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="SSH Connect: ssh ..."
                            android:textColor="#B9F6CA"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_page3_finish"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Open Server Hub"
                        android:textColor="@android:color/black"
                        android:textSize="16sp"
                        app:backgroundTint="#00E676"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Navigation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_page3_back"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="← Back"
                    android:textColor="#BB86FC"
                    app:strokeColor="#BB86FC"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </LinearLayout>

    </ViewFlipper>

</LinearLayout>
